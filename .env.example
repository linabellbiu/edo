# EDO 面向用户时大写，环境变量统一使用 EDO_ 前缀。
# mage start、mage start --dev 和直接运行 edo 使用本段宿主机配置；已存在的进程环境变量优先于 .env。
EDO_ENV=development
EDO_LOG_LEVEL=info
EDO_LOG_FILE_ENABLED=true
EDO_LOG_DIRECTORY=logs
EDO_LOG_MAX_FILE_SIZE_MB=100
EDO_LOG_COMPRESS_AFTER_DAYS=3
EDO_SERVER_ADDRESS=:8080
# 仅填写实际可信反向代理的 IP/CIDR，多个值用逗号分隔；默认不信任转发头，禁止全网 /0。
EDO_SERVER_TRUSTED_PROXIES=
EDO_AUTH_SESSION_TTL=8h
EDO_AUTH_COOKIE_NAME=edo_session
# 生产环境默认为 true；本地 HTTP 开发环境使用 false。
EDO_AUTH_COOKIE_SECURE=false
EDO_AUTH_LOGIN_MAX_FAILURE=5
EDO_AUTH_LOGIN_WINDOW=15m

# 宿主机数据库连接。默认 SQLite；切换为 postgres 或 mysql 时替换 DRIVER 与 DSN。
EDO_DATABASE_DRIVER=sqlite
EDO_DATABASE_DSN=data/edo.db
EDO_DATABASE_MAX_OPEN_CONNS=25
EDO_DATABASE_MAX_IDLE_CONNS=5
EDO_DATABASE_CONN_MAX_LIFETIME=1h

# 脚本构建的中间输出；任务结束后会自动回收。
EDO_BUILD_DIRECTORY=data/builds
# 文件制品按 SHA256 内容寻址保存；Compose 的 data 卷会持久化默认目录。
EDO_ARTIFACTS_DIRECTORY=data/artifacts
# 单个上传或脚本构建制品上限，默认 1 GiB（字节）。
EDO_ARTIFACTS_MAX_BYTES=1073741824

# 正式 Compose 的本地部署目录；留空使用宿主机执行 Compose 用户的 ~/edo/deply。
# 由 bootstrap 与 API 共同挂载，配置文件不进入 Git 或镜像构建上下文。
EDO_DEPLOY_HOST_DIRECTORY=

# Runner 式仓库缓存：仓库地址 Hash 下按 Tag 版本号或 Commit 保存隔离工作区。
EDO_GIT_DIRECTORY=data/repositories
EDO_GIT_CACHE_DIRECTORY=data/cache

# 宿主机 Redis 连接。URL 可包含用户名、密码和数据库编号；不得提交真实凭据。
# go-redis/v9 显式使用 RESP2，EDO 最低兼容 Redis Server 7.0。
EDO_REDIS_URL=redis://127.0.0.1:6379/0
EDO_REDIS_KEY_PREFIX=edo:
EDO_REDIS_TIMEOUT=3s

# 宿主机 NATS JetStream 连接。URL 可包含认证信息；不得提交真实凭据。
EDO_NATS_URL=nats://127.0.0.1:4222
EDO_NATS_STREAM=edo_tasks
EDO_NATS_DEAD_STREAM=edo_dead
EDO_NATS_SUBJECT_PREFIX=edo.task
EDO_NATS_DEAD_SUBJECT=edo.dead.task.v1
# 包含首次执行，4 表示首次执行加最多 3 次重试；禁止设置为 -1。
EDO_NATS_MAX_ATTEMPTS=4
EDO_NATS_TIMEOUT=5s
EDO_NATS_MAX_AGE=168h
# 字节数；默认任务 512 MiB、死信 256 MiB，按 JetStream 可用磁盘调整。
EDO_NATS_MAX_BYTES=536870912
EDO_NATS_DEAD_MAX_BYTES=268435456
EDO_NATS_REPLICAS=1

EDO_WORKER_CONCURRENCY=8
# 任务并发数；Docker/BuildKit 支持并行构建时，最多同时执行此数量的任务。
EDO_WORKER_TASK_TIMEOUT=30m
# server 进程异常退出后，任务超过租约时间才允许其他实例接管。
EDO_WORKER_LEASE_DURATION=45s
EDO_WORKER_SHUTDOWN_TIMEOUT=30s

# 正式 Docker Compose 可留空：首次启动自动生成并固定保存至 data/bootstrap/secrets-key。
# 本地二进制、Mage 和开发 Compose 仍需填写 32 字节随机密钥的 Base64。
# 已有 .env 或密文时继续使用原密钥，不能覆盖模板或删除 data/bootstrap 重新生成。
# 生成示例：openssl rand -base64 32
EDO_SECRETS_KEY=
EDO_GIT_TIMEOUT=30s
# 使用 SSH 私钥时必须提供可信 known_hosts 文件，EDO 不会关闭主机指纹校验。
EDO_GIT_KNOWN_HOSTS_FILE=

EDO_RUNTIME_CONNECT_TIMEOUT=10s
EDO_RUNTIME_REQUEST_TIMEOUT=30s
# 单个容器或 Pod WebSocket 终端的最长持续时间，允许 1 分钟至 24 小时。
EDO_RUNTIME_TERMINAL_MAX_DURATION=2h
# 二进制和 mage start --dev 不设置该变量，直接使用当前宿主机 Docker CLI/daemon。
# 显式 TCP 构建运行时必须同时提供包含 ca.pem、cert.pem、key.pem 的 mTLS 客户端证书目录。
# Compose 已在容器环境中使用自动签发证书的 tcp://docker-builder:2376；客户端证书只读挂载给 API。
# EDO_DOCKER_BUILDER_HOST=tcp://docker-builder:2376
# EDO_DOCKER_BUILDER_TLS_CERT_PATH=/absolute/path/to/docker/client-certs

# Docker Compose 容器内连接覆盖。容器中的 127.0.0.1 指向容器自身，不能复用上面的宿主机地址。
# 正式 Compose 默认启动 PostgreSQL，DSN 留空时自动使用生成的数据库密码。
# 使用外部数据库或保留已有 SQLite 时，首次启动前填写实际 DRIVER 和 DSN，不自动跨库搬迁。
EDO_COMPOSE_DATABASE_DRIVER=postgres
EDO_COMPOSE_DATABASE_DSN=
# 开发 Compose 默认仍用 SQLite，不额外启动 PostgreSQL；不影响上面的正式部署。
EDO_DEV_COMPOSE_DATABASE_DRIVER=sqlite
EDO_DEV_COMPOSE_DATABASE_DSN=/app/data/edo.db
# Compose 不自动信任私网或构建器；未配置时审计及登录限流记录 Web 容器地址。
# 如需客户端地址，仅填写明确受控的反向代理来源；API 不可单独对外暴露。
EDO_COMPOSE_SERVER_TRUSTED_PROXIES=
EDO_COMPOSE_BUILD_DIRECTORY=/app/data/builds
EDO_COMPOSE_ARTIFACTS_DIRECTORY=/app/data/artifacts
EDO_COMPOSE_GIT_DIRECTORY=/app/data/repositories
EDO_COMPOSE_GIT_CACHE_DIRECTORY=/app/data/cache
EDO_COMPOSE_REDIS_URL=redis://redis:6379/0
EDO_COMPOSE_NATS_URL=nats://nats:4222

# 正式 Compose 的 Web 入口默认可通过服务器 IP 访问；只供本机代理时设为 127.0.0.1。
EDO_HTTP_BIND=0.0.0.0
# 正式 Compose 的 Web 端口；开发 Compose 使用同值映射 Go API。
EDO_HTTP_PORT=8080
# 仅用于 Vite 开发前端，不改变正式 Web 入口。
EDO_WEB_PORT=5173
# 下列依赖端口仅由开发 Compose 映射；修改时同步上面的宿主机连接 URL。
EDO_REDIS_PORT=6379
EDO_NATS_PORT=4222
EDO_NATS_MONITOR_PORT=8222

# 定时任务和监控规则扫描间隔；多 Worker 依赖数据库条件更新避免重复领取。
EDO_SCHEDULER_POLL_INTERVAL=15s

# 仅在执行旧数据迁移时临时设置；生产环境应使用只读来源账户，不要提交真实 DSN。
# EDO_LEGACY_DATABASE_DRIVER=mysql
# EDO_LEGACY_DATABASE_DSN=readonly:password@tcp(127.0.0.1:3306)/edo_legacy?charset=utf8mb4&parseTime=True&loc=UTC

# 正式 Compose 镜像源：按 docker.aityp.com 真实同步条目设置，默认 Linux amd64。
# ARM64 宿主机首次安装使用 .env.arm64.example；已有安装按 docs/deployment.md 合并设置。
EDO_DOCKER_PLATFORM=linux/amd64
# 构建器自身的平台，与流水线的镜像构建平台分别配置。
# DinD 必须使用宿主机原生架构，不能通过 amd64 仿真运行 ARM64 宿主机上的构建器。
EDO_DOCKER_BUILDER_PLATFORM=linux/amd64
EDO_BOOTSTRAP_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/library/alpine:3.22
EDO_POSTGRES_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/postgres:17.11-trixie
EDO_REDIS_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/redis:7.4.9
# 指定站暂无 NATS 2.12.12，保留原版本，通过 DaoCloud 代理下载。
EDO_NATS_IMAGE=docker.m.daocloud.io/library/nats:2.12.12-alpine
EDO_DOCKER_BUILDER_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/library/docker:29.8.2-dind
EDO_DOCKER_CLI_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/library/docker:29.8.2-cli
EDO_GO_BUILD_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/library/golang:1.26.10-alpine
EDO_API_BASE_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/library/debian:bookworm-slim
EDO_NODE_BUILD_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/node:24.16.0-trixie-slim
EDO_WEB_BASE_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/nginx:1.30.6-alpine3.24
# 仅用于构建阶段下载公开 Go/npm 依赖，不携带运行凭据。
EDO_GO_PROXY=https://goproxy.cn,direct
EDO_NPM_REGISTRY=https://registry.npmmirror.com
# Debian 软件包仍由官方签名校验，镜像构建时使用国内下载站，不改宿主机 apt 源。
EDO_DEBIAN_MIRROR=http://mirrors.huaweicloud.com

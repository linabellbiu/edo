# EDO 面向用户时大写，环境变量统一使用 EDO_ 前缀。
# mage start、mage start --dev 和直接运行 edo 使用本段宿主机配置；已存在的进程环境变量优先于 .env。
EDO_ENV=development
EDO_LOG_LEVEL=info
EDO_LOG_FILE_ENABLED=true
EDO_LOG_DIRECTORY=logs
EDO_LOG_MAX_FILE_SIZE_MB=100
EDO_LOG_COMPRESS_AFTER_DAYS=3
EDO_SERVER_ADDRESS=:8080
# 生产镜像内为 /app/web；设为空可只运行 API。
EDO_WEB_ROOT=web/dist
EDO_AUTH_SESSION_TTL=8h
EDO_AUTH_COOKIE_NAME=edo_session
# 生产环境默认为 true；本地 HTTP 开发环境使用 false。
EDO_AUTH_COOKIE_SECURE=false
EDO_AUTH_LOGIN_MAX_FAILURE=5
EDO_AUTH_LOGIN_WINDOW=15m

# 宿主机数据库连接。默认 SQLite；切换为 postgres 或 mysql 时替换 DRIVER 与 DSN。
EDO_DATABASE_DRIVER=sqlite
EDO_DATABASE_DSN=data/edo.db
EDO_DATABASE_MAX_OPEN_CONNS=25
EDO_DATABASE_MAX_IDLE_CONNS=5
EDO_DATABASE_CONN_MAX_LIFETIME=1h

# 文件制品按 SHA256 内容寻址保存；Compose 的 data 卷会持久化默认目录。
EDO_ARTIFACTS_DIRECTORY=data/artifacts
# 单个上传或脚本构建制品上限，默认 1 GiB（字节）。
EDO_ARTIFACTS_MAX_BYTES=1073741824

# Runner 式仓库缓存：仓库地址 Hash 下按 Tag 版本号或 Commit 保存隔离工作区。
EDO_GIT_DIRECTORY=data/repositories

# 宿主机 Redis 连接。URL 可包含用户名、密码和数据库编号；不得提交真实凭据。
# go-redis/v9 显式使用 RESP2，EDO 最低兼容 Redis Server 7.0。
EDO_REDIS_URL=redis://127.0.0.1:6379/0
EDO_REDIS_KEY_PREFIX=edo:
EDO_REDIS_TIMEOUT=3s

# 宿主机 NATS JetStream 连接。URL 可包含认证信息；不得提交真实凭据。
EDO_NATS_URL=nats://127.0.0.1:4222
EDO_NATS_STREAM=edo_tasks
EDO_NATS_DEAD_STREAM=edo_dead
EDO_NATS_SUBJECT_PREFIX=edo.task
EDO_NATS_DEAD_SUBJECT=edo.dead.task.v1
# 包含首次执行，4 表示首次执行加最多 3 次重试；禁止设置为 -1。
EDO_NATS_MAX_ATTEMPTS=4
EDO_NATS_TIMEOUT=5s
EDO_NATS_MAX_AGE=168h
# 字节数；默认任务 512 MiB、死信 256 MiB，按 JetStream 可用磁盘调整。
EDO_NATS_MAX_BYTES=536870912
EDO_NATS_DEAD_MAX_BYTES=268435456
EDO_NATS_REPLICAS=1

EDO_WORKER_CONCURRENCY=8
# 真实任务处理协程数；Docker/BuildKit 支持并行构建时，最多可同时执行这里配置的任务数。
EDO_WORKER_TASK_TIMEOUT=30m
# server 进程异常退出后，任务超过租约时间才允许其他实例接管。
EDO_WORKER_LEASE_DURATION=45s
EDO_WORKER_SHUTDOWN_TIMEOUT=30s

# 32 字节随机密钥的 Base64。Mage 首次启动时会复制本模板并生成、持久化该值。
# 已有 .env 时 Mage 不会覆盖或轮换密钥；首次生成后必须固定保存并备份。
# 直接使用 Docker Compose 时仍需先复制本模板并自行填写；已有密文时不得生成新密钥替代原密钥。
# 生成示例：openssl rand -base64 32
EDO_SECRETS_KEY=
EDO_GIT_TIMEOUT=30s
# 使用 SSH 私钥时必须提供可信 known_hosts 文件，EDO 不会关闭主机指纹校验。
EDO_GIT_KNOWN_HOSTS_FILE=

EDO_RUNTIME_CONNECT_TIMEOUT=10s
EDO_RUNTIME_REQUEST_TIMEOUT=30s
# 单个容器或 Pod WebSocket 终端的最长持续时间，允许 1 分钟至 24 小时。
EDO_RUNTIME_TERMINAL_MAX_DURATION=2h
# 二进制和 mage start --dev 不设置该变量，直接使用当前宿主机 Docker CLI/daemon。
# 显式 TCP 构建运行时必须同时提供包含 ca.pem、cert.pem、key.pem 的 mTLS 客户端证书目录。
# Compose 已在容器环境中使用自动签发证书的 tcp://docker-builder:2376；客户端证书只读挂载给 API。
# EDO_DOCKER_BUILDER_HOST=tcp://docker-builder:2376
# EDO_DOCKER_BUILDER_TLS_CERT_PATH=/absolute/path/to/docker/client-certs

# Docker Compose 容器内连接覆盖。容器中的 127.0.0.1 指向容器自身，不能复用上面的宿主机地址。
# 两份 Compose 文件会把这些值映射成容器进程实际读取的 EDO_DATABASE_*、EDO_REDIS_URL 和 EDO_NATS_URL。
EDO_COMPOSE_DATABASE_DRIVER=sqlite
EDO_COMPOSE_DATABASE_DSN=/app/data/edo.db
EDO_COMPOSE_ARTIFACTS_DIRECTORY=/app/data/artifacts
EDO_COMPOSE_GIT_DIRECTORY=/app/data/repositories
EDO_COMPOSE_REDIS_URL=redis://redis:6379/0
EDO_COMPOSE_NATS_URL=nats://nats:4222

# Compose 映射到宿主机的端口。修改 Redis/NATS 端口时，也要同步修改上面的宿主机连接 URL。
EDO_HTTP_PORT=8080
EDO_WEB_PORT=5173
EDO_REDIS_PORT=6379
EDO_NATS_PORT=4222
EDO_NATS_MONITOR_PORT=8222

# 定时任务和监控规则扫描间隔；多 Worker 依赖数据库条件更新避免重复领取。
EDO_SCHEDULER_POLL_INTERVAL=15s

# 仅在执行旧数据迁移时临时设置；生产环境应使用只读来源账户，不要提交真实 DSN。
# EDO_LEGACY_DATABASE_DRIVER=mysql
# EDO_LEGACY_DATABASE_DSN=readonly:password@tcp(127.0.0.1:3306)/edo_legacy?charset=utf8mb4&parseTime=True&loc=UTC

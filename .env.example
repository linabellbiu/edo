# ZRT 面向用户时大写，环境变量统一使用 ZRT_ 前缀。
ZRT_ENV=development
ZRT_LOG_LEVEL=info
ZRT_SERVER_ADDRESS=:8080
# 生产镜像内为 /app/web；设为空可只运行 API。
ZRT_WEB_ROOT=web/dist
ZRT_AUTH_SESSION_TTL=8h
ZRT_AUTH_COOKIE_NAME=zrt_session
# 生产环境默认为 true；本地 HTTP 开发环境使用 false。
ZRT_AUTH_COOKIE_SECURE=false
ZRT_AUTH_LOGIN_MAX_FAILURE=5
ZRT_AUTH_LOGIN_WINDOW=15m

# 默认 SQLite；切换为 postgres 或 mysql 时替换 DRIVER 与 DSN。
ZRT_DATABASE_DRIVER=sqlite
ZRT_DATABASE_DSN=data/zrt.db
ZRT_DATABASE_MAX_OPEN_CONNS=25
ZRT_DATABASE_MAX_IDLE_CONNS=5
ZRT_DATABASE_CONN_MAX_LIFETIME=1h

# go-redis/v9 显式使用 RESP2，ZRT 最低兼容 Redis Server 7.0。
ZRT_REDIS_URL=redis://127.0.0.1:6379/0
ZRT_REDIS_KEY_PREFIX=zrt:
ZRT_REDIS_TIMEOUT=3s

ZRT_NATS_URL=nats://127.0.0.1:4222
ZRT_NATS_STREAM=zrt_tasks
ZRT_NATS_DEAD_STREAM=zrt_dead
ZRT_NATS_SUBJECT_PREFIX=zrt.task
ZRT_NATS_DEAD_SUBJECT=zrt.dead.task.v1
# 包含首次执行，4 表示首次执行加最多 3 次重试；禁止设置为 -1。
ZRT_NATS_MAX_ATTEMPTS=4
ZRT_NATS_TIMEOUT=5s
ZRT_NATS_MAX_AGE=168h
# 字节数；默认任务 512 MiB、死信 256 MiB，按 JetStream 可用磁盘调整。
ZRT_NATS_MAX_BYTES=536870912
ZRT_NATS_DEAD_MAX_BYTES=268435456
ZRT_NATS_REPLICAS=1

ZRT_WORKER_CONCURRENCY=8
ZRT_WORKER_TASK_TIMEOUT=30m
# server 进程异常退出后，任务超过租约时间才允许其他实例接管。
ZRT_WORKER_LEASE_DURATION=45s
ZRT_WORKER_SHUTDOWN_TIMEOUT=30s

# 32 字节随机密钥的 Base64。缺省时只允许使用无需凭据、无需 Webhook 的公开仓库。
# 生成示例：openssl rand -base64 32
ZRT_SECRETS_KEY=
ZRT_GIT_TIMEOUT=30s
# 使用 SSH 私钥时必须提供可信 known_hosts 文件，ZRT 不会关闭主机指纹校验。
ZRT_GIT_KNOWN_HOSTS_FILE=

ZRT_RUNTIME_CONNECT_TIMEOUT=10s
ZRT_RUNTIME_REQUEST_TIMEOUT=30s
# 单个容器或 Pod WebSocket 终端的最长持续时间，允许 1 分钟至 24 小时。
ZRT_RUNTIME_TERMINAL_MAX_DURATION=2h

# 定时任务和监控规则扫描间隔；多 Worker 依赖数据库条件更新避免重复领取。
ZRT_SCHEDULER_POLL_INTERVAL=15s

# 仅在执行旧数据迁移时临时设置；生产环境应使用只读来源账户，不要提交真实 DSN。
# ZRT_LEGACY_DATABASE_DRIVER=mysql
# ZRT_LEGACY_DATABASE_DSN=readonly:password@tcp(127.0.0.1:3306)/zrt_legacy?charset=utf8mb4&parseTime=True&loc=UTC

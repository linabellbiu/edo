# ARM64 宿主机首次安装的 Docker Compose 配置：复制为 .env 后启动。
# 已有安装仅合并下列公开设置，保留原有密钥、数据库和端口配置。
# EDO、Web、依赖和 DinD 原生运行；流水线的镜像构建平台仍默认 linux/amd64。
EDO_DOCKER_PLATFORM=linux/arm64
EDO_DOCKER_BUILDER_PLATFORM=linux/arm64

# 使用支持 ARM64 的官方多架构镜像，与 amd64 模板的软件版本保持一致。
EDO_BOOTSTRAP_IMAGE=docker.io/library/alpine:3.22
EDO_POSTGRES_IMAGE=docker.io/library/postgres:17.11-trixie
EDO_REDIS_IMAGE=docker.io/library/redis:7.4.9
EDO_NATS_IMAGE=docker.io/library/nats:2.12.12-alpine
EDO_DOCKER_BUILDER_IMAGE=docker.io/library/docker:29.8.2-dind
EDO_DOCKER_CLI_IMAGE=docker.io/library/docker:29.8.2-cli
EDO_GO_BUILD_IMAGE=docker.io/library/golang:1.26.10-alpine
EDO_API_BASE_IMAGE=docker.io/library/debian:bookworm-slim
EDO_NODE_BUILD_IMAGE=docker.io/library/node:24.16.0-trixie-slim
EDO_WEB_BASE_IMAGE=docker.io/library/nginx:1.30.6-alpine3.24

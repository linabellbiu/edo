# 兼容旧 .env 和 Compose 命令环境中的显式覆盖。空值交给 Go 默认值。
EDO_LOG_LEVEL=${EDO_LOG_LEVEL:-}
EDO_LOG_FILE_ENABLED=${EDO_LOG_FILE_ENABLED:-}
EDO_LOG_MAX_FILE_SIZE_MB=${EDO_LOG_MAX_FILE_SIZE_MB:-}
EDO_LOG_COMPRESS_AFTER_DAYS=${EDO_LOG_COMPRESS_AFTER_DAYS:-}
EDO_BUILD_DIRECTORY=${EDO_COMPOSE_BUILD_DIRECTORY:-}
EDO_ARTIFACTS_DIRECTORY=${EDO_COMPOSE_ARTIFACTS_DIRECTORY:-}
EDO_ARTIFACTS_MAX_BYTES=${EDO_ARTIFACTS_MAX_BYTES:-}
EDO_GIT_DIRECTORY=${EDO_COMPOSE_GIT_DIRECTORY:-}
EDO_GIT_CACHE_DIRECTORY=${EDO_COMPOSE_GIT_CACHE_DIRECTORY:-}
